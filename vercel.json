{
  "rewrites": [
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/pricing/", "destination": "/pricing/index.html" },
    { "source": "/building", "destination": "/building/index.html" },
    { "source": "/building/", "destination": "/building/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/pricing/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/building/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
